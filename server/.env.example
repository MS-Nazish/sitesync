PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sitesync
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Supervisors cannot edit an attendance record after this many hours
ATTENDANCE_LOCK_HOURS=24
# Attendance saved offline on a phone may be uploaded up to this many days later
OFFLINE_SYNC_DAYS=3

# ---- Wage slips by WhatsApp / SMS ----
# Address workers use to open slip links (your deployed site). Defaults to the address the app is opened on.
PUBLIC_URL=
# Country code added to local numbers like 0300-1234567 (92 = Pakistan)
DEFAULT_COUNTRY_CODE=92
# Slip links stop working this many days after the payroll week ends
SLIP_LINK_DAYS=60
# none    = only WhatsApp / SMS links that open on your phone (free, no setup)
# console = print messages in the server log (demo)
# twilio  = send from the server through Twilio
MESSAGE_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. +15017122661
TWILIO_SMS_FROM=
# e.g. whatsapp:+14155238886 (Twilio WhatsApp sandbox or approved sender)
TWILIO_WHATSAPP_FROM=
